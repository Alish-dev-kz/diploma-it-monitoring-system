@startuml
!include _style.iuml
skinparam usecase {
  BackgroundColor #DAE8FC
  BorderColor #6C8EBF
}
skinparam actorStyle awesome
skinparam nodesep 25
skinparam defaultFontSize 16
skinparam ranksep 60
title Use Case диаграммасы: ITMon мониторинг жүйесі

actor "Жүйе әкімшісі" as Adm
actor "Техникалық қолдау\nинженері" as Eng
actor "IT-бөлім басшысы" as Mgr

rectangle "ITMon" {
  usecase "UC-13 Пайдаланушылар мен\nрөлдерді басқару" as UC13
  usecase "UC-12 Шекті мәндерді\nбаптау" as UC12
  usecase "UC-15 Аудит журналын\nқарау" as UC15
  usecase "UC-09 Қашықтан команда\nжіберу" as UC09
  usecase "UC-07 Ескертулерді қарау\nжәне растау" as UC07
  usecase "UC-04 Құрылғылар тізімін\nжәне күйін көру" as UC04
  usecase "UC-14 Есеп жасау" as UC14

  usecase "UC-01 Жүйеге кіру" as UC01 #F5D48A
  usecase "UC-11 Командаға құқықты\nтексеру" as UC11
  usecase "UC-08 Инцидент ашу" as UC08
  usecase "UC-05 Көрсеткіштер\nтарихын көру" as UC05
  usecase "UC-16 Диск толуын\nболжау" as UC16

  usecase "UC-10 Команданы алу\nжәне орындау" as UC10
  usecase "UC-06 Ауытқуды анықтау\n(N рет қатарынан)" as UC06
  usecase "UC-03 Метрикаларды\nжіберу" as UC03
  usecase "UC-02 Агентті тіркеу" as UC02
}
actor "Мониторинг агенті\n<<system>>" as Agent

Adm -|> Eng
Adm -- UC13
Adm -- UC12
Adm -- UC15
Eng -- UC09
Eng -- UC07
Eng -- UC04
Mgr -- UC04
Mgr -- UC14
Mgr -- UC15

UC13 ..> UC01 : <<include>>
UC12 ..> UC01 : <<include>>
UC09 ..> UC01 : <<include>>
UC07 ..> UC01 : <<include>>
UC04 ..> UC01 : <<include>>
UC14 ..> UC01 : <<include>>
UC09 ..> UC11 : <<include>>
UC08 .up.> UC07 : <<extend>>
UC05 .up.> UC04 : <<extend>>
UC16 .left.> UC05 : <<extend>>
UC03 .left.> UC06 : <<include>>

UC10 -- Agent
UC06 -[hidden]- Agent
UC03 -- Agent
UC02 -- Agent
UC11 -[hidden]- UC10
@enduml
